# Copy to .env and fill in.
#
# ⚠️  Anything prefixed with VITE_ is inlined into the public JavaScript bundle
#     at build time. It is NOT secret. Never put a private key here.
#
#     Secrets belong in your hosting provider's environment variables and must
#     only be read from server-side code.

# ── Supabase (required) ─────────────────────────────────────────────────────
# The publishable / "anon" key is designed to be public. Security comes from
# Row Level Security policies, so enable RLS on every table.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"

VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# ── Stock backgrounds (optional) ────────────────────────────────────────────
# Free-tier, rotatable keys only. Leave empty to disable stock search.
VITE_PIXABAY_API_KEY=""
VITE_PEXELS_API_KEY=""
